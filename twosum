#include <vector>
using namespace std;

class Solution {
public:
    // Use std::vector instead of raw arrays for dynamic sizing
    vector<int> twoSum(vector<int>& nums, int target) {
        for (int i = 0; i < nums.size(); i++) {
            for (int j = i + 1; j < nums.size(); j++) {
                if (nums[i] + nums[j] == target) {
                    // In C++, we return a list initialization
                    return {i, j}; 
                }
            }
        }
        return {};
    }
};